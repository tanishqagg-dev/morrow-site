NEXT_PUBLIC_JARVIS_VERSION=Pilot 0.3
NEXT_PUBLIC_SUPPORT_URL=https://www.linkedin.com/company/skills4u-skills-and-theatre-based-training/
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LICENSE_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1

# Public browser credentials for the activation API and the operator login.
# Never place an sb_secret_ key in this website.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PROJECT_PUBLISHABLE_KEY

# Customer sign-in. Copy the publishable key and Frontend API URL from the same
# Clerk application. Production requires a pk_live_ key and an HTTPS origin.
# Enable Google in Clerk's social connection settings and verify the site domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_key
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=https://your-clerk-frontend-api.example

# Set only when deploying behind a known public origin.
JARVIS_SITE_ORIGIN=http://localhost:3000

# Enable only after Netlify detects morrow-demo and a test request is verified.
# Localhost previews never send, even when this is true.
NEXT_PUBLIC_DEMO_FORM_ENABLED=false

# Morrow /subscribe uses Clerk. The Supabase Edge Function validates Clerk
# sessions; its Clerk secret key and JWT public key stay in Supabase secrets.
# Razorpay's public Key ID is returned by the server at checkout. Never add a
# Razorpay API or webhook secret here.

# Customer-facing bulk package contact address
NEXT_PUBLIC_BULK_EMAIL=

# A closed public release omits Clerk keys and never loads customer checkout.
# Keep false until production Clerk and the LIVE billing backend are ready.
NEXT_PUBLIC_CHECKOUT_ENABLED=false
